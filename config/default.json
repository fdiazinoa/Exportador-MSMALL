{
    "logging": {
        "level": "info",
        "filename": "logs/app.log"
    },
    "databases": {
        "sqlserver_prod": {
            "provider": "sqlserver",
            "config": {
                "user": "sa",
                "password": "yourStrong(!)Password",
                "server": "localhost",
                "database": "TestDB",
                "options": {
                    "encrypt": true,
                    "trustServerCertificate": true
                }
            }
        },
        "mysql_legacy": {
            "provider": "mysql",
            "config": {
                "host": "localhost",
                "user": "root",
                "password": "password",
                "database": "legacy_db"
            }
        }
    },
    "ftpServers": {
        "ftp_main": {
            "host": "ftp.example.com",
            "user": "user",
            "password": "password",
            "secure": false
        }
    },
    "webServices": {
        "msmall_local": {
            "baseUrl": "http://127.0.0.1:8000",
            "clientId": "msa_xxx",
            "clientSecret": "replace-me",
            "mallId": "00000000-0000-0000-0000-000000000001",
            "localId": "00000000-0000-0000-0000-000000000010",
            "configId": "00000000-0000-0000-0000-000000000010",
            "syncPath": "/api/v1/exporter/sync/ingest",
            "manualExecutePath": "/api/v1/remote/execute-manual/exporter",
            "auth": {
                "tokenPath": "/auth/token",
                "refreshPath": "/auth/refresh"
            },
            "mode": "sync_rows",
            "chunkSize": 500,
            "timeoutMs": 30000,
            "retry": {
                "maxAttempts": 3,
                "baseDelayMs": 1000,
                "maxDelayMs": 30000
            }
        }
    },
    "jobs": [
        {
            "name": "DailySales",
            "sourceConnection": "sqlserver_prod",
            "query": "SELECT * FROM Sales WHERE Date >= DATEADD(day, -1, GETDATE())",
            "format": "csv",
            "destination": "ftp_main",
            "mappingFile": "mappings/sales_map.json"
        },
        {
            "name": "DailySalesToMsMall",
            "sourceConnection": "sqlserver_prod",
            "query": "SELECT * FROM Sales WHERE Date >= DATEADD(day, -1, GETDATE())",
            "format": "json",
            "destinationType": "webservice",
            "destination": "msmall_local",
            "mapping": {
                "StoreId": "local_codigo",
                "InvoiceNo": "factura_numero",
                "SaleDate": "fecha_venta",
                "GrossTotal": "total_bruto",
                "NetTotal": "total_neto",
                "TaxTotal": "total_impuestos"
            }
        },
        {
            "name": "PushTicketsHiOffice",
            "type": "hioffice_push",
            "sourceConnection": "sqlserver_prod",
            "query": "SELECT * FROM PendingTickets WHERE Status = 'Ready'",
            "credentials": {
                "email": "user@example.com",
                "password": "securePassword",
                "isoLanguage": "es"
            },
            "importId": "Importación Tíquets",
            "payloadFormat": "json"
        }
    ]
}
