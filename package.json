{
  "name": "exportador-msmall-node",
  "version": "16.6.0",
  "description": "Exportador MSMall V16 con ediciones Standard y Legacy-2008",
  "main": "index.js",
  "bin": "index.js",
  "pkg": {
    "scripts": "src/**/*.js",
    "assets": [
      "config/**/*",
      "frontend/dist/**/*"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "dist"
  },
  "scripts": {
    "test": "node test/run.js",
    "build:frontend": "npm --prefix frontend run build",
    "release:pack": "node scripts/release-pack.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "basic-ftp": "^5.3.1",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "fast-csv": "^5.0.5",
    "mysql2": "^3.15.3",
    "node-cron": "^4.2.1",
    "pg": "^8.16.3",
    "ssh2-sftp-client": "^12.0.1",
    "tedious": "^19.1.3",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "archiver": "^7.0.1",
    "pkg": "^5.8.1"
  }
}
